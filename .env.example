#
# Example environment variables for the BootSignal backend.
# Put real secrets only in .env or in AWS environment variables/secrets.
#

# Active profile and server port
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Local MySQL connection
DB_URL=jdbc:mysql://localhost:3306/bootsignal?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=bootsignal
DB_PASSWORD=bootsignal

# Production database variables used by application-prod.yml
# SPRING_PROFILES_ACTIVE=prod
# DB_HOST=xxxx.rds.amazonaws.com
# DB_PORT=3306
# DB_NAME=bootsignal
# DB_USERNAME=<rds_username>
# DB_PASSWORD=<rds_password>
# SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Multipart upload limits
MULTIPART_MAX_FILE_SIZE=100MB
MULTIPART_MAX_REQUEST_SIZE=120MB

# JWT settings
JWT_ISSUER=bootsignal
JWT_SECRET=replace-this-with-a-strong-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_VALIDITY_SECONDS=3600
JWT_REFRESH_TOKEN_VALIDITY_SECONDS=1209600
# JWT 쿠키 보안 정책. 운영 HTTPS 환경은 Secure=true를 사용한다.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax

# Password reset and mail settings
PASSWORD_RESET_VALIDITY_SECONDS=1800
PASSWORD_RESET_RESPONSE_TOKEN_ENABLED=false
PASSWORD_RESET_URL_TEMPLATE=http://localhost:5173/reset-password?token={token}
PASSWORD_RESET_MAIL_ENABLED=false
PASSWORD_RESET_MAIL_FROM=no-reply@bootsignal.com
PASSWORD_RESET_MAIL_SUBJECT=BootSignal password reset

# SMTP settings used when password reset mail is enabled
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true

# Secret used to encrypt tokens stored in the database
TOKEN_ENCRYPTION_SECRET=replace-this-with-a-strong-secret-at-least-32-bytes

# Google login and Google Calendar OAuth settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8080/api/calendar/connect/google/callback
GOOGLE_CALENDAR_SCOPE=openid email profile https://www.googleapis.com/auth/calendar.events
GOOGLE_CALENDAR_CONNECT_SUCCESS_URL=http://localhost:5173/dashboard/schedule
GOOGLE_CALENDAR_CONNECT_FAILURE_URL=http://localhost:5173/dashboard/schedule

# Kakao login settings
KAKAO_CLIENT_ID=
KAKAO_JWK_SET_URI=https://kauth.kakao.com/.well-known/jwks.json

# Comma-separated CORS allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AWS and S3 settings
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=bootsignal-local

# CodeBuild / ECR deployment variables
# AWS_DEFAULT_REGION=ap-northeast-2
# ECR_REGISTRY=<aws_account_id>.dkr.ecr.ap-northeast-2.amazonaws.com
# ECR_REPOSITORY_URI=<aws_account_id>.dkr.ecr.ap-northeast-2.amazonaws.com/bootsignal-backend
# CONTAINER_NAME=bootsignal-backend

# Elastic Beanstalk deployment variables
# EB_APPLICATION_NAME=team5-bootsignal
# EB_ENVIRONMENT_NAME=team5-bootsignal-prod
# SERVER_PORT=5000

# OpenAI settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_MILLIS=30000
OPENAI_TEMPERATURE=
OPENAI_MAX_OUTPUT_TOKENS=

# Tech article RSS settings
YOZM_RSS_FEED_URL=https://yozm.wishket.com/magazine/feed/
KAKAO_TECH_RSS_FEED_URL=https://tech.kakao.com/feed/
D2_NAVER_RSS_FEED_URL=https://d2.naver.com/d2.atom
WOOWAHAN_RSS_FEED_URL=https://techblog.woowahan.com/feed/
TOSS_TECH_RSS_FEED_URL=https://toss.tech/rss.xml
TECH_ARTICLE_COLLECT_LIMIT=30
TECH_ARTICLE_COLLECT_WITHIN_MONTHS=6
TECH_ARTICLE_RSS_TIMEOUT_MILLIS=15000
TECH_ARTICLE_RSS_USER_AGENT=Mozilla/5.0 BootSignalRssCollector/1.0

# Work24 HRD OpenAPI settings
HRD_API_AUTH_KEY=
HRD_API_BASE_URL=https://www.work24.go.kr/cm/openApi/call/hr
HRD_API_RETURN_TYPE=JSON

# Work24 crawling defaults
WORK24_CRAWLER_DEFAULT_COURSE_URL=https://www.work24.go.kr/hr/a/a/3100/selectTracseDetl.do?tracseId=AIG20240000498288&tracseTme=7&crseTracseSe=C0061&trainstCstmrId=500036172479
WORK24_CRAWLER_OUTPUT_PATH=build/crawled/work24-training-course-overview.json
WORK24_CRAWLER_TIMEOUT_MILLIS=30000
WORK24_CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Profile image storage settings
PROFILE_IMAGE_STORAGE_TYPE=local
PROFILE_IMAGE_UPLOAD_DIR=temp-storage/profile-images
PROFILE_IMAGE_PUBLIC_PATH_PREFIX=/local-files/profile
PROFILE_IMAGE_BASE_URL=http://localhost:8080

# ─────────────────────────────────────────────────────
# Batch Scheduler settings
# ─────────────────────────────────────────────────────
# 스케줄러 활성화 여부. 기본값 false — 운영(prod) 환경에서만 true로 설정한다.
# 로컬/개발 환경에서는 반드시 false 유지 (실수로 크롤링 Job이 실행되는 것 방지)
# SCHEDULER_ENABLED=true

# cron 표현식 (Spring 6-field: 초 분 시 일 월 요일)
# HRD API 수집 — 매주 월요일 새벽 2시
# HRD_COLLECT_CRON=0 0 2 * * MON

# Raw 데이터 정제 — 매주 월요일 새벽 3시 (수집 완료 후 1시간 여유)
# HRD_REFINE_CRON=0 0 3 * * MON

# HTML 크롤링 보강 — 매주 수요일 새벽 2시 (초기 이후 신규 데이터만 처리)
# HRD_WEB_CRAWL_CRON=0 0 2 * * WED

# 수강후기 크롤링 — 매주 수요일 새벽 4시 (HTML 크롤링 완료 후 2시간 여유)
# REVIEW_CRAWL_CRON=0 0 4 * * WED

# RSS 기술아티클 수집 — 매주 월요일 오전 9시
# TECH_ARTICLE_COLLECT_CRON=0 0 9 * * MON

# 수강후기 과정당 최대 크롤링 페이지 수 (페이지당 10건)
# 기본값 10 = 최대 100건/과정. AI 요약은 기본 50건만 사용하므로 10페이지로 충분.
# 초기 Full-crawl 시 더 많은 리뷰가 필요하면 값을 높여 수동 트리거 가능.
# REVIEW_MAX_PAGES=10
